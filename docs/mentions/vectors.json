{
  "about": "Conformance vectors for ADR 0016 (docs/adr/0016-what-a-mention-is.md). mentions: each text and the Handles it mentions, in order, each once. handles: strings that are and are not Handles.",
  "mentions": [
    {"text": "", "mentions": [], "why": "empty text"},
    {"text": "no mentions here", "mentions": [], "why": "no @"},
    {"text": "@auditor", "mentions": ["auditor"], "why": "the whole text"},
    {"text": "ask @auditor", "mentions": ["auditor"], "why": "at the end"},
    {"text": "@auditor, please look", "mentions": ["auditor"], "why": "comma ends it"},
    {"text": "(@auditor) and @scribe.", "mentions": ["auditor", "scribe"], "why": "brackets and full stop"},
    {"text": "@auditor's view", "mentions": ["auditor"], "why": "apostrophe ends it"},
    {"text": "@scribe then @auditor", "mentions": ["scribe", "auditor"], "why": "order of appearance"},
    {"text": "@auditor @scribe @auditor", "mentions": ["auditor", "scribe"], "why": "each once, first place"},
    {"text": "line\n@auditor\n", "mentions": ["auditor"], "why": "newlines are not word characters"},
    {"text": "mail a@b.com or 9@x", "mentions": [], "why": "letter or digit before @"},
    {"text": "é@auditor", "mentions": [], "why": "a non-ASCII letter before @"},
    {"text": "_@auditor", "mentions": ["auditor"], "why": "_ is not a word character"},
    {"text": "@@x", "mentions": [], "why": "@ before @, and nothing after the first"},
    {"text": "@@x @y", "mentions": ["y"], "why": "only the doubled one is out"},
    {"text": "@ alone", "mentions": [], "why": "nothing after @"},
    {"text": "trailing @", "mentions": [], "why": "@ at the end"},
    {"text": "@_x @-x", "mentions": [], "why": "a Handle starts with a letter or digit"},
    {"text": "\\@auditor", "mentions": [], "why": "backslash escapes"},
    {"text": "\\\\@auditor", "mentions": [], "why": "no escape for the backslash itself"},
    {"text": "\\ @auditor", "mentions": ["auditor"], "why": "a space after the backslash"},
    {"text": "@Auditor", "mentions": ["auditor"], "why": "ASCII case folds"},
    {"text": "@AUDITOR and @auditor", "mentions": ["auditor"], "why": "folded, then each once"},
    {"text": "@auditorX", "mentions": ["auditorx"], "why": "the whole word, not a prefix"},
    {"text": "@aud @audi @audit @auditing", "mentions": ["aud", "audi", "audit", "auditing"], "why": "no prefix matching"},
    {"text": "@auditoré", "mentions": [], "why": "a non-ASCII letter after"},
    {"text": "@auditoŕ", "mentions": [], "why": "a combining mark after"},
    {"text": "@auditor²", "mentions": [], "why": "a number after"},
    {"text": "@auditor@host", "mentions": ["auditor"], "why": "@ is not a word character; the second @ follows r"},
    {"text": "@au-di @au_di_2", "mentions": ["au-di", "au_di_2"], "why": "single separators between alphanumerics"},
    {"text": "@auditor-like", "mentions": ["auditor-like"], "why": "one separator joins"},
    {"text": "ask @auditor-", "mentions": ["auditor"], "why": "a trailing separator is punctuation"},
    {"text": "@auditor_, @scribe__ then", "mentions": ["auditor", "scribe"], "why": "trailing separators"},
    {"text": "@auditor--like this", "mentions": ["auditor"], "why": "-- is not part of a Handle"},
    {"text": "@auditor-é", "mentions": ["auditor"], "why": "a separator not followed by ASCII alphanumeric"},
    {"text": "@au-Di", "mentions": ["au-di"], "why": "case folds after a separator"},
    {"text": "@user hi", "mentions": ["user"], "why": "reserved, but still a mention, which never resolves"},
    {"text": "@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "mentions": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "why": "65 characters: a mention that never resolves"}
  ],
  "handles": {
    "valid": ["a", "7", "audit", "au-di", "au_di_2", "a-b_c-d", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"],
    "invalid": ["", "user", "Audit", "-au", "_au", "au-", "au_", "au--di", "au-_di", "au di", "audé", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"]
  }
}
